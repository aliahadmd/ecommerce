# ─── Single source of truth for env vars (see plans/phase1/plan-1.md §7) ────
# Copy to .env with `make env`, then adjust. Dev defaults match docker-compose.yml.

# App
NODE_ENV=development
PORT=3000

# Postgres 17 + pgvector (container: ecommerce-postgres)
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce

# Redis 7 (container: ecommerce-redis)
REDIS_URL=redis://localhost:6379

# SeaweedFS S3-compatible storage (container: ecommerce-seaweedfs)
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_URL=http://localhost:8333/products
S3_BUCKET=products
S3_ACCESS_KEY=ecommerce-dev
S3_SECRET_KEY=ecommerce-dev-secret
S3_REGION=us-east-1

# SMTP — Mailpit in dev (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ecommerce <no-reply@dev.local>

# Auth (better-auth)
BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Set to false on demo hosts: sign-up signs in immediately (no inbox needed)
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Seed
SUPER_ADMIN_EMAIL=admin@dev.local
SUPER_ADMIN_PASSWORD=Admin1234!
# Demo hosts only: allow demo data with NODE_ENV=production, and give the demo
# seller/buyer this password (empty = Seller1234! / Buyer1234!)
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=

# AI (OpenRouter) — leave OPENROUTER_API_KEY empty to disable AI features
OPENROUTER_API_KEY=
AI_MODEL=z-ai/glm-4.6
AI_DAILY_LIMIT=500

# Payments — 'fake' uses the local dev gateway; 'stripe' needs STRIPE_SECRET_KEY
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional dedicated HMAC key for fake-gateway callbacks (defaults to a key derived from BETTER_AUTH_SECRET)
PAYMENT_CALLBACK_SECRET=
# Unpaid card orders are cancelled and their stock released after this many minutes
CARD_PAYMENT_TTL_MINUTES=30

# Commerce
CURRENCY=USD
SHIPPING_FEE_CENTS=0
