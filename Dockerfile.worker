# Background worker (BullMQ email + notification queues). Same codebase as the
# web app; runs the worker entry instead of the HTTP server.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/redis/package.json packages/redis/
COPY packages/email/package.json packages/email/
COPY packages/jobs/package.json packages/jobs/
RUN pnpm fetch

FROM base AS runtime
WORKDIR /repo
COPY --from=deps /repo/package.json ./package.json
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages ./packages
COPY --from=deps /repo/apps/worker ./apps/worker
USER node
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@ecommerce/worker", "exec", "tsx", "src/index.ts"]
